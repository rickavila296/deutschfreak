{
  "name": "deutschfreak",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "content:check": "pnpm --filter @deutschfreak/content validate",
    "test:db": "pnpm --filter @deutschfreak/db test:db && pnpm --filter @deutschfreak/api test:db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
