# Names only, never values. Copy to .env and fill in locally; .env is never committed (TRD-ENV-02).
# These names are proposed in TRD §25 and fixed in Phase 3, so they stay commented out until then.
# Never prefix a secret with NEXT_PUBLIC_ (TRD-ENV-01).

# apps/api
# DATABASE_URL=
# DATABASE_URL_DIRECT=
# WEB_ORIGIN=

# packages/db database tests: a separate Neon branch, direct connection (decision 0012)
# DATABASE_URL_TEST=

# apps/web
# NEXT_PUBLIC_API_URL=
