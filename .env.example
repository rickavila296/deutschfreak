# Names only, never values. Copy to .env and fill in locally; .env is never committed (TRD-ENV-02).
# Names fixed in Phase 3 task 3.8 (TRD §25). Never prefix a secret with NEXT_PUBLIC_ (TRD-ENV-01).

# apps/api, locally and in the Vercel API project (Production and Preview; previews use the dev branch, decision 0019)
# Neon pooled connection string (host contains -pooler); used by the running API (TRD-BE-07)
DATABASE_URL=
# Neon direct connection string of the same branch; used by migrate, seed and the scripts (TRD-DB-14)
DATABASE_URL_DIRECT=
# The one browser origin CORS allows, a bare origin such as https://deutschfreak.com (TRD-SEC-15)
WEB_ORIGIN=
# Local development server port only (default 4000); not set on Vercel
# PORT=

# packages/db and apps/api database tests: a separate Neon branch, direct connection (decisions 0012, 0018).
# In CI it is the GitHub secret DATABASE_URL_TEST, with DATABASE_DEV_HOST (dev endpoint host only) (decision 0016).
DATABASE_URL_TEST=

# apps/web (Phase 4)
# NEXT_PUBLIC_API_URL=
